Screen {
    layout: vertical;
}

#main-pane {
    height: 1fr;
}

#tasks-pane {
    width: 40;
    min-width: 30;
    border: round $primary;
    padding: 0 1;
}

#logs-pane {
    width: 1fr;
    border: round $accent;
    padding: 0 1;
}

#tasks-title {
    height: 1;
    padding: 0 0 0 1;
    color: $text-muted;
}

#log-title {
    height: 1;
    padding: 0 0 0 1;
    color: $text-muted;
}

#task-table {
    height: 1fr;
}

#log-view {
    height: 1fr;
}
